# SMS provider and sending mode
SMS_DRIVER=Kavenegar
# sync = send immediately (default); queue = use Laravel's default queue connection
SMS_MODE=sync
SMS_TIMEOUT=15

# Used only when SMS_MODE=queue
SMS_QUEUE=sms
SMS_QUEUE_TRIES=3
SMS_QUEUE_TIMEOUT=60

KAVENEGAR_API_KEY=
SMSIR_API_KEY=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
