{
    "name": "abolfazlrastegar/laravel-sms",
    "description": "Multi-provider SMS integration for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "illuminate/http": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/bus": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Abolfazlrastegar\\LaravelSms\\": "src/"
        }
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/promises": "^1.5",
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abolfazlrastegar\\LaravelSms\\Providers\\SmsServiceProvider"
            ],
            "aliases": {
                "Sms": "Abolfazlrastegar\\LaravelSms\\Facades\\Sms",
                "Payments": "Abolfazlrastegar\\LaravelSms\\Facades\\Sms"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
